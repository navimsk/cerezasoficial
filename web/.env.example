# Copiar como .env y completar. Estas variables son PÚBLICAS (van al navegador).
# Nunca poner aquí la clave service_role / secret.

# Proyecto Supabase (solo la base, SIN /rest/v1/)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave pública: "anon" o "publishable"
VITE_SUPABASE_ANON_KEY=

# Clave pública VAPID para notificaciones push (fase 7)
VITE_VAPID_PUBLIC_KEY=

# demo = siempre datos simulados · supabase = siempre Supabase · auto = Supabase si hay URL y clave
VITE_MODO_DATOS=auto
